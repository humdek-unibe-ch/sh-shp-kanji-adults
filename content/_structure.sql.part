-- -----------------------------------------------------------------------
-- Plugin registration
-- -----------------------------------------------------------------------

INSERT IGNORE INTO `plugins` (`name`, `version`)
    VALUES ('kanji-adults', 'v1.0.0');

INSERT IGNORE INTO `lookups` (`type_code`, `lookup_code`, `lookup_value`, `lookup_description`)
    VALUES ('transactionBy', 'by_kanji_adults', 'By Kanji Adults',
            'The action was performed by the Kanji Adults plugin');

-- -----------------------------------------------------------------------
-- Page 1: welcome / landing
-- Open access: participants arrive from a letter, before any login.
-- -----------------------------------------------------------------------

INSERT IGNORE INTO `pages` (
    `id`, `keyword`, `url`, `protocol`,
    `id_actions`, `id_navigation_section`, `parent`,
    `is_headless`, `nav_position`, `footer_position`,
    `id_type`, `id_pageAccessTypes`
) VALUES (
    NULL, 'kanji-adults', '/kanji-adults', 'GET',
    '0000000003', NULL, NULL,
    '0', NULL, NULL,
    (SELECT id FROM pageType WHERE name = 'experiment'),
    (SELECT id FROM lookups WHERE type_code = 'pageAccessTypes' AND lookup_code = 'web')
);

SET @kanji_welcome = (SELECT id FROM pages WHERE keyword = 'kanji-adults');

INSERT IGNORE INTO `pages_fields_translation` (`id_pages`, `id_fields`, `id_languages`, `content`)
VALUES
    (@kanji_welcome, get_field_id('label'), '0000000002', 'Kanji Lernaufgabe'),
    (@kanji_welcome, get_field_id('title'), '0000000002', 'Kanji Lernaufgabe');

-- Welcome sections
INSERT IGNORE INTO `sections` (`id_styles`, `name`, `owner`)
    VALUES (get_style_id('container'), 'kanji-welcome-container', NULL);
INSERT IGNORE INTO `sections` (`id_styles`, `name`, `owner`)
    VALUES (get_style_id('markdown'), 'kanji-welcome-text', NULL);

SET @kw_container = (SELECT id FROM sections WHERE name = 'kanji-welcome-container');
SET @kw_text      = (SELECT id FROM sections WHERE name = 'kanji-welcome-text');

INSERT IGNORE INTO `sections_fields_translation` (`id_sections`, `id_fields`, `id_languages`, `id_genders`, `content`)
VALUES
    (@kw_container, get_field_id('css'),      '0000000001', '0000000001', 'mt-4 px-3'),
    (@kw_container, get_field_id('is_fluid'), '0000000001', '0000000001', '0');

INSERT IGNORE INTO `sections_fields_translation` (`id_sections`, `id_fields`, `id_languages`, `id_genders`, `content`)
VALUES
    (@kw_text, get_field_id('text_md'), '0000000002', '0000000001',
'# Willkommen

Vielen Dank für Ihr Interesse an unserer Studie.

Diese Lernaufgabe dauert etwa **30 Minuten**. Bitte bearbeiten Sie sie an
einem ruhigen Ort und in einem Zug — Sie können sie nicht unterbrechen
und später fortsetzen.

Sie benötigen den **Code aus dem Brief**, den Sie erhalten haben.

[Aufgabe starten](/kanji-adults-survey)');

INSERT IGNORE INTO `sections_hierarchy` (`parent`, `child`, `position`) VALUES
    (@kw_container, @kw_text, 0);

INSERT IGNORE INTO `pages_sections` (`id_pages`, `id_sections`, `position`)
VALUES (@kanji_welcome, @kw_container, 0);

-- -----------------------------------------------------------------------
-- Page 2: part 1 questionnaire (consent, code, demographics)
-- Renders the surveyjs survey. Select the published survey in the CMS after
-- importing kanji_part1.surveyjs.json in Module SurveyJS.
-- -----------------------------------------------------------------------

INSERT IGNORE INTO `pages` (
    `id`, `keyword`, `url`, `protocol`,
    `id_actions`, `id_navigation_section`, `parent`,
    `is_headless`, `nav_position`, `footer_position`,
    `id_type`, `id_pageAccessTypes`
) VALUES (
    NULL, 'kanji-adults-survey', '/kanji-adults-survey', 'GET|POST',
    '0000000003', NULL, NULL,
    '0', NULL, NULL,
    (SELECT id FROM pageType WHERE name = 'experiment'),
    (SELECT id FROM lookups WHERE type_code = 'pageAccessTypes' AND lookup_code = 'web')
);

SET @kanji_survey = (SELECT id FROM pages WHERE keyword = 'kanji-adults-survey');

INSERT IGNORE INTO `pages_fields_translation` (`id_pages`, `id_fields`, `id_languages`, `content`)
VALUES
    (@kanji_survey, get_field_id('label'), '0000000002', 'Kanji — Angaben'),
    (@kanji_survey, get_field_id('title'), '0000000002', 'Kanji — Angaben');

INSERT IGNORE INTO `sections` (`id_styles`, `name`, `owner`)
    VALUES (get_style_id('surveyJS'), 'kanji-survey-part1', NULL);

SET @ks_part1 = (SELECT id FROM sections WHERE name = 'kanji-survey-part1');

-- redirect_at_end sends the participant into the timed task once part 1 is
-- submitted. The survey `survey-js` field must be set in the CMS to the
-- published "Kanji Part 1" survey — it references a surveys row id that does
-- not exist until the JSON is imported, so it cannot be set here.
INSERT IGNORE INTO `sections_fields_translation` (`id_sections`, `id_fields`, `id_languages`, `id_genders`, `content`)
VALUES
    (@ks_part1, get_field_id('redirect_at_end'),   '0000000001', '0000000001', 'kanji-adults-task'),
    (@ks_part1, get_field_id('restart_on_refresh'),'0000000001', '0000000001', '0'),
    (@ks_part1, get_field_id('own_entries_only'),  '0000000001', '0000000001', '1');

INSERT IGNORE INTO `pages_sections` (`id_pages`, `id_sections`, `position`)
VALUES (@kanji_survey, @ks_part1, 0);

